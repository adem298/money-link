# Solana Devnet only. Copy this file to .env.local before configuring the client.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# After `anchor deploy --provider.cluster devnet`, set the address from `anchor keys list`.
# Until then, the app uses the checked-in non-deployed placeholder and disables escrow actions.
# VITE_PROGRAM_ID=your_deployed_program_public_key
